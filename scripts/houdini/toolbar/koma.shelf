<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- The "Koma" shelf: live LED / playbar link to koma (scripts/houdini/koma_shelf.py). -->
  <toolshelf name="koma" label="Koma">
    <memberTool name="koma_led_live"/>
    <memberTool name="koma_camera_live"/>
    <memberTool name="koma_send_plans"/>
    <memberTool name="koma_led_send"/>
    <memberTool name="koma_stop"/>
    <memberTool name="koma_export_set"/>
    <memberTool name="koma_lens_setup"/>
    <memberTool name="koma_settings"/>
  </toolshelf>

  <tool name="koma_led_live" label="LED Live" icon="SOP_color">
    <helpText><![CDATA[Toggle: send the LED point cloud's colours to koma whenever the LED node cooks (a parameter change as much as a new frame), and the frame number with them. In koma, set Houdini Live > LED to Live.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.toggle_led_live()
]]></script>
  </tool>

  <tool name="koma_camera_live" label="Camera Live" icon="OBJ_camera">
    <helpText><![CDATA[Toggle: send the camera's pose to koma whenever it moves. koma's Box Rig follows while Houdini Live > Rig is on there (inside the rig limits, sequence idle).]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.toggle_camera_live()
]]></script>
  </tool>

  <tool name="koma_send_plans" label="Send Plans" icon="SOP_timeshift">
    <helpText><![CDATA[Write the camera pose (plus its focus, when the camera has the Koma Lens setup: the focus-target distance through the lens table) and the LED wall of every koma frame between koma's in and out points into koma's plans on the layer selected in koma (Houdini evaluated at koma frame + previz offset). Replaces plans already there.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.send_plans()
]]></script>
  </tool>

  <tool name="koma_led_send" label="LED Send" icon="SOP_attribwrangle">
    <helpText><![CDATA[Send the LED colours of the current frame to koma, once.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.send_led()
]]></script>
  </tool>

  <tool name="koma_stop" label="Koma Stop" icon="BUTTONS_stop">
    <helpText><![CDATA[Stop following the playbar and disconnect from koma-relay.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.stop()
]]></script>
  </tool>

  <tool name="koma_export_set" label="Export Set" icon="ROP_geometry">
    <helpText><![CDATA[Write the LED placement to the koma project's previz/set.json. Needed once, and again when the layout changes.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.export_set()
]]></script>
  </tool>

  <tool name="koma_lens_setup" label="Lens Setup" icon="OBJ_camera_switch">
    <helpText><![CDATA[Drive the camera's focal length, aperture and focus from the lens table koma measured (the project's calibration.json): adds a "Koma Lens" folder to the camera with a focus-target object (a null to put on the subject; /obj/focus_target is made if there is none) or a focus distance in mm. Moving the camera or the target refocuses the previz the way the rig would. A macro lens focused close is nothing like its nameplate.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.lens_setup()
]]></script>
  </tool>

  <tool name="koma_settings" label="Koma Settings" icon="BUTTONS_gear">
    <helpText><![CDATA[Relay address, token, and which nodes to send.]]></helpText>
    <script scriptType="python"><![CDATA[import sys
import hou
p = hou.getenv('KOMA_HOUDINI')
if p and p not in sys.path:
    sys.path.append(p)
import koma_shelf
koma_shelf.configure()
]]></script>
  </tool>
</shelfDocument>
